# Copy to backend/.env and edit. Everything has a sensible default; the app runs without this file.

# Where the mock ERP runs
ERP_BASE_URL=http://localhost:8001

# rules = free, offline, pattern-based (default works for the 3 known layouts)
# auto  = rules first, Claude only when rules can't read the invoice (scans, unknown layouts)
# llm   = Claude for every invoice
EXTRACTOR=auto

# Needed for auto/llm. Leave empty to run fully offline.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Auto-approve invoices that pass every check (false = everything goes to a human)
AUTO_APPROVE=true

# Allowed unit-price difference vs the PO, in percent
PRICE_TOLERANCE_PCT=0.5
# Allowed rounding difference in arithmetic checks
AMOUNT_TOLERANCE=0.02

# Mock ERP only: fraction of requests that fail with 503, to test retries
ERP_FAIL_RATE=0
